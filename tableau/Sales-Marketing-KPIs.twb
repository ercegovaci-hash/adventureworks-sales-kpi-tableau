      <column caption='YOY Growth' datatype='real' name='[Calculation_1441996357687869440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([SalesAmount]) - LOOKUP(SUM([SalesAmount]), -1))&#13;&#10;/ LOOKUP(SUM([SalesAmount]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sales CY' datatype='real' name='[Calculation_1441996357694672901]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED: SUM(if YEAR([OrderDate])={MAX(YEAR([OrderDate]))}&#13;&#10;THEN [SalesAmount]&#13;&#10;END&#13;&#10;)}' />
      </column>
      <column caption='% ' datatype='real' default-format='*+0.00%;-0.00%' name='[Calculation_1441996357697155079]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_1441996357694672901])-SUM([Sales CY (copy)_1441996357696741382]))&#13;&#10;/&#13;&#10;SUM([Sales CY (copy)_1441996357696741382])' />
      </column>
      <column caption='Last 12 months' datatype='boolean' name='[Calculation_1441996357698084872]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[OrderDate])&#13;&#10;&gt;=&#13;&#10;DATEADD(&apos;month&apos;,-11,{MAX(DATETRUNC(&apos;month&apos;,[OrderDate]))} )' />
      </column>
      <column caption='Customer' datatype='string' name='[Calculation_1441996357710573581]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[FirstName]+&quot; &quot;+[LastName]' />
      </column>
      <column caption='Profit' datatype='real' name='[Calculation_702843074231091203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[SalesAmount]-[TotalProductCost]' />
      </column>
      <column caption='Profit Margin' datatype='real' default-format='p0.00%' name='[Calculation_702843074231431172]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([SalesAmount] - [TotalProductCost]) / SUM([SalesAmount])' />
      </column>
      <column caption='Rank Customers' datatype='integer' name='[Calculation_74590926361108480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([SalesAmount]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
